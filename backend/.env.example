# Bulebet Backend Production Environment Configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Production Connection URI
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/bulebet_prod?retryWrites=true&w=majority

# Security Keys
JWT_SECRET=production_jwt_secret_min_32_chars_random_string_here

# Domain Origins (CORS & Auth Callbacks)
CLIENT_ORIGIN=https://bulebeti.com
FRONTEND_URL=https://bulebeti.com

# Optional SMTP Email Service Credentials
EMAIL_USER=support@bulebeti.com
EMAIL_PASS=your_smtp_app_password

# Google OAuth Client ID (Optional)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Gemini AI Assistant API Key
GEMINI_API_KEY=your_gemini_api_key_here
