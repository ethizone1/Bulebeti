# ==========================================
# BULEBET BACKEND PRODUCTION ENVIRONMENT CONFIG
# ==========================================

PORT=5000
NODE_ENV=production

# MongoDB Production Connection String (Replace with your Atlas or DB URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/bulebet_db?retryWrites=true&w=majority

# Security Key for JWT Authentication (Minimum 32 characters)
JWT_SECRET=super_secret_jwt_key_bulebet_production_2026_x987a

# Allowed Frontend Origins (Your Production Domain)
CLIENT_ORIGIN=https://bulebeti.com
FRONTEND_URL=https://bulebeti.com

# Optional SMTP Configuration for Real Email Delivery
EMAIL_SERVICE=gmail
EMAIL_USER=support@bulebeti.com
EMAIL_PASS=your_app_password_here
